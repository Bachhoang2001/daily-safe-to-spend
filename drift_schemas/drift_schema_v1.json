    {
      "name": "budget_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budget_profiles\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'USD', \"income_mode\" TEXT NOT NULL, \"pay_frequency\" TEXT NULL, \"pay_anchor_date\" TEXT NULL, \"income_per_paycheck_cents\" INTEGER NULL, \"first_period_balance_cents\" INTEGER NULL, \"starting_balance_cents\" INTEGER NULL, \"tracking_start_date\" TEXT NOT NULL, \"safety_horizon_days\" INTEGER NOT NULL DEFAULT 14, \"buffer_percent\" INTEGER NOT NULL DEFAULT 0, \"rollover_mode\" TEXT NOT NULL DEFAULT 'spread', \"timezone\" TEXT NOT NULL DEFAULT 'UTC', \"week_start\" INTEGER NOT NULL DEFAULT 1, \"onboarding_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_completed\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "income_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"income_entries\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"received_on\" TEXT NOT NULL, \"note\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "bills",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bills\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"recurrence\" TEXT NOT NULL, \"first_due_date\" TEXT NOT NULL, \"remind_days_before\" INTEGER NOT NULL DEFAULT 1, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"spent_on\" TEXT NOT NULL, \"category_id\" TEXT NULL, \"note\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"currency\" TEXT NOT NULL DEFAULT 'USD', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL, \"custom_name\" TEXT NULL, \"icon\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
