        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"target_amount_cents\" INTEGER NOT NULL, \"target_date\" TEXT NULL, \"per_paycheck_cents\" INTEGER NULL, \"created_on\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
